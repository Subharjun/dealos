{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_escrow_is_funded": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "gc_payment",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "gc_state eq 303300001",
              "subscriptionRequest/filteringattributes": "gc_state"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "To_funded": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "actionName": "gc_TransitionDeal",
                  "item/DealId": "@{triggerOutputs()?['body/_gc_deal_value']}",
                  "item/TargetStage": 303300007,
                  "item/Reason": "Escrow partner confirmed funding"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Funded_refused": {
              "type": "If",
              "expression": "@not(equals(outputs('To_funded')?['body/Allowed'], true))",
              "actions": {
                "Funded_stuck_task": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_reviewtasks",
                      "item/gc_name": "@{take(concat('Escrow funded but deal not moved: ', triggerOutputs()?['body/gc_name']), 100)}",
                      "item/gc_kind": 303300001,
                      "item/gc_purpose": 303300009,
                      "item/gc_assigneerole": 303300002,
                      "item/gc_status": 303300000,
                      "item/gc_payload": "@{string(addProperty(json('{}'), 'failures', outputs('To_funded')?['body/Failures']))}",
                      "item/gc_deal@odata.bind": "gc_deals(@{triggerOutputs()?['body/_gc_deal_value']})"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Stop_not_funded": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {
                    "Funded_stuck_task": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "To_funded": [
                  "Succeeded"
                ]
              }
            },
            "Run_Logistics": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "actionName": "gc_Agent_Logistics",
                  "item/Input": "{\"trigger\": \"flow:escrow-funded\"}",
                  "item/SubjectId": "@{triggerOutputs()?['body/_gc_deal_value']}"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {
                "Funded_refused": [
                  "Succeeded"
                ]
              }
            },
            "Check_Logistics": {
              "type": "If",
              "expression": "@not(equals(outputs('Run_Logistics')?['body/Status'], 'Succeeded'))",
              "actions": {
                "Record_Logistics_failure": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_flowfailures",
                      "item/gc_name": "DealOS | Escrow funded",
                      "item/gc_flowname": "DealOS | Escrow funded",
                      "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                      "item/gc_step": "Run_Logistics",
                      "item/gc_error": "@{coalesce(outputs('Run_Logistics')?['body/Summary'], 'agent call failed')}",
                      "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                      "item/gc_status": 303300000
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Stop_Logistics_failed": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "DealOSFlowFailure",
                      "message": "Logistics agent failed; see Flow failures"
                    }
                  },
                  "runAfter": {
                    "Record_Logistics_failure": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Run_Logistics": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Parse_Logistics": {
              "type": "ParseJson",
              "inputs": {
                "content": "@json(coalesce(outputs('Run_Logistics')?['body/Result'], '{}'))",
                "schema": {
                  "type": "object",
                  "properties": {
                    "agent": {
                      "type": "string"
                    },
                    "run_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "result": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "scope": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "checklist": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "document": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "required_by": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "status": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "document_id": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            }
                          }
                        },
                        "next_steps": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "risks": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "summary": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "needs_human": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "confidence": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "actions": {
                      "type": [
                        "array",
                        "null"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Check_Logistics": [
                  "Succeeded"
                ]
              }
            },
            "Deal": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_deals",
                  "recordId": "@{triggerOutputs()?['body/_gc_deal_value']}",
                  "$select": "gc_name,_gc_buyer_value,_gc_seller_value"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Parse_Logistics": [
                  "Succeeded"
                ]
              }
            },
            "Notify_buyer": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{body('Deal')?['_gc_buyer_value']}",
                  "text_1": "Escrow funded",
                  "text_2": "Escrow for '@{body('Deal')?['gc_name']}' is funded. Inspection and shipment are being arranged; track the milestones in DealOS.",
                  "text_3": "deal.funded"
                }
              },
              "runAfter": {
                "Deal": [
                  "Succeeded"
                ]
              }
            },
            "Notify_seller": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{body('Deal')?['_gc_seller_value']}",
                  "text_1": "Buyer has funded escrow",
                  "text_2": "The buyer has funded escrow for '@{body('Deal')?['gc_name']}'. Prepare the material for inspection; the document checklist is in DealOS.",
                  "text_3": "deal.funded"
                }
              },
              "runAfter": {
                "Notify_buyer": [
                  "Succeeded"
                ]
              }
            },
            "Audit": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_auditevents",
                  "item/gc_hash": "set-by-invariants-plugin",
                  "item/gc_name": "deal.funded",
                  "item/gc_actor": "flow:escrow-funded",
                  "item/gc_action": "deal.funded",
                  "item/gc_subjecttype": "gc_deal",
                  "item/gc_subjectid": "@{triggerOutputs()?['body/_gc_deal_value']}",
                  "item/gc_details": "@{take(string(addProperty(json('{}'), 'logistics', outputs('Run_Logistics')?['body/Summary'])), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Notify_seller": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | Escrow funded",
                  "item/gc_flowname": "DealOS | Escrow funded",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}