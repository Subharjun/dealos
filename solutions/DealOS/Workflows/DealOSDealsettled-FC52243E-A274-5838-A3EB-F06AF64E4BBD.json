{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_deal_is_settled": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "gc_deal",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "gc_stage eq 303300010",
              "subscriptionRequest/filteringattributes": "gc_stage"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Buyer_account": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "accounts",
                  "recordId": "@{triggerOutputs()?['body/_gc_buyer_value']}",
                  "$select": "name,gc_trusttier"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Buyer_open_upgrade": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_reviewtasks",
                  "$select": "gc_reviewtaskid",
                  "$filter": "gc_status eq 303300000 and gc_purpose eq 303300000 and _gc_account_value eq @{coalesce(triggerOutputs()?['body/_gc_buyer_value'], '00000000-0000-0000-0000-000000000000')}",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Buyer_account": [
                  "Succeeded"
                ]
              }
            },
            "Buyer_first_trade": {
              "type": "If",
              "expression": "@and(equals(body('Buyer_account')?['gc_trusttier'], 303300002), equals(length(outputs('Buyer_open_upgrade')?['body/value']), 0))",
              "actions": {
                "Buyer_tier_task": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_reviewtasks",
                      "item/gc_name": "@{take(concat('Tier upgrade to Trade Verified: ', body('Buyer_account')?['name']), 100)}",
                      "item/gc_kind": 303300000,
                      "item/gc_purpose": 303300000,
                      "item/gc_assigneerole": 303300001,
                      "item/gc_status": 303300000,
                      "item/gc_payload": "@{string(addProperty(addProperty(addProperty(addProperty(json('{}'), 'tier', 'Trade Verified'), 'tierValue', 303300003), 'reason', 'First trade settled on DealOS'), 'deal', triggerOutputs()?['body/gc_dealid']))}",
                      "item/gc_account@odata.bind": "accounts(@{triggerOutputs()?['body/_gc_buyer_value']})"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Buyer_open_upgrade": [
                  "Succeeded"
                ]
              }
            },
            "Seller_account": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "accounts",
                  "recordId": "@{triggerOutputs()?['body/_gc_seller_value']}",
                  "$select": "name,gc_trusttier"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Buyer_first_trade": [
                  "Succeeded"
                ]
              }
            },
            "Seller_open_upgrade": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_reviewtasks",
                  "$select": "gc_reviewtaskid",
                  "$filter": "gc_status eq 303300000 and gc_purpose eq 303300000 and _gc_account_value eq @{coalesce(triggerOutputs()?['body/_gc_seller_value'], '00000000-0000-0000-0000-000000000000')}",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Seller_account": [
                  "Succeeded"
                ]
              }
            },
            "Seller_first_trade": {
              "type": "If",
              "expression": "@and(equals(body('Seller_account')?['gc_trusttier'], 303300002), equals(length(outputs('Seller_open_upgrade')?['body/value']), 0))",
              "actions": {
                "Seller_tier_task": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_reviewtasks",
                      "item/gc_name": "@{take(concat('Tier upgrade to Trade Verified: ', body('Seller_account')?['name']), 100)}",
                      "item/gc_kind": 303300000,
                      "item/gc_purpose": 303300000,
                      "item/gc_assigneerole": 303300001,
                      "item/gc_status": 303300000,
                      "item/gc_payload": "@{string(addProperty(addProperty(addProperty(addProperty(json('{}'), 'tier', 'Trade Verified'), 'tierValue', 303300003), 'reason', 'First trade settled on DealOS'), 'deal', triggerOutputs()?['body/gc_dealid']))}",
                      "item/gc_account@odata.bind": "accounts(@{triggerOutputs()?['body/_gc_seller_value']})"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Seller_open_upgrade": [
                  "Succeeded"
                ]
              }
            },
            "Notify_buyer": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{triggerOutputs()?['body/_gc_buyer_value']}",
                  "text_1": "Deal settled: please rate your counterparty",
                  "text_2": "'@{triggerOutputs()?['body/gc_name']}' is settled. Please take a minute to rate the other party in DealOS (quality, timeliness, communication, documents). Ratings build each company's trust tier.",
                  "text_3": "deal.settled"
                }
              },
              "runAfter": {
                "Seller_first_trade": [
                  "Succeeded"
                ]
              }
            },
            "Notify_seller": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{triggerOutputs()?['body/_gc_seller_value']}",
                  "text_1": "Deal settled: please rate your counterparty",
                  "text_2": "'@{triggerOutputs()?['body/gc_name']}' is settled. Please take a minute to rate the other party in DealOS (quality, timeliness, communication, documents). Ratings build each company's trust tier.",
                  "text_3": "deal.settled"
                }
              },
              "runAfter": {
                "Notify_buyer": [
                  "Succeeded"
                ]
              }
            },
            "Audit": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_auditevents",
                  "item/gc_hash": "set-by-invariants-plugin",
                  "item/gc_name": "deal.settled",
                  "item/gc_actor": "flow:deal-settled",
                  "item/gc_action": "deal.settled",
                  "item/gc_subjecttype": "gc_deal",
                  "item/gc_subjectid": "@{triggerOutputs()?['body/gc_dealid']}",
                  "item/gc_details": "@{take(string(addProperty(addProperty(json('{}'), 'buyer', triggerOutputs()?['body/_gc_buyer_value']), 'seller', triggerOutputs()?['body/_gc_seller_value'])), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Notify_seller": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | Deal settled",
                  "item/gc_flowname": "DealOS | Deal settled",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}