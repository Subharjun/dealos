{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_both_sides_opt_in": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "gc_match",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "gc_buyeroptin,gc_selleroptin"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@and(equals(triggerOutputs()?['body/gc_buyeroptin'], true), equals(triggerOutputs()?['body/gc_selleroptin'], true), not(equals(triggerOutputs()?['body/gc_status'], 303300002)))"
            }
          ],
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Mark_mutual": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_matchs",
                  "recordId": "@{triggerOutputs()?['body/gc_matchid']}",
                  "item/gc_status": 303300002
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Existing_deal": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_deals",
                  "$select": "gc_dealid",
                  "$filter": "_gc_requirement_value eq @{triggerOutputs()?['body/_gc_requirement_value']} and _gc_listing_value eq @{triggerOutputs()?['body/_gc_listing_value']}",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Mark_mutual": [
                  "Succeeded"
                ]
              }
            },
            "Already_connected": {
              "type": "If",
              "expression": "@greater(length(outputs('Existing_deal')?['body/value']), 0)",
              "actions": {
                "Deal_exists": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Existing_deal": [
                  "Succeeded"
                ]
              }
            },
            "Requirement": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_buyerrequirements",
                  "recordId": "@{triggerOutputs()?['body/_gc_requirement_value']}",
                  "$select": "gc_name,_gc_buyer_value,gc_quantity,gc_quantityunit,gc_incoterm,gc_currency,_gc_destinationcountry_value"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Already_connected": [
                  "Succeeded"
                ]
              }
            },
            "Listing": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_listings",
                  "recordId": "@{triggerOutputs()?['body/_gc_listing_value']}",
                  "$select": "gc_name,_gc_seller_value,_gc_commodity_value,_gc_origincountry_value,gc_currency,gc_incoterm,gc_namedplace"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Requirement": [
                  "Succeeded"
                ]
              }
            },
            "Create_deal": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_deals",
                  "item/gc_name": "@{take(concat('RFQ: ', body('Listing')?['gc_name']), 100)}",
                  "item/gc_stage": 303300000,
                  "item/gc_currency": "@{coalesce(body('Requirement')?['gc_currency'], body('Listing')?['gc_currency'], 'USD')}",
                  "item/gc_quantity": "@body('Requirement')?['gc_quantity']",
                  "item/gc_quantityunit": "@body('Requirement')?['gc_quantityunit']",
                  "item/gc_incoterm": "@coalesce(body('Requirement')?['gc_incoterm'], body('Listing')?['gc_incoterm'])",
                  "item/gc_namedplace": "@{coalesce(body('Listing')?['gc_namedplace'], '')}",
                  "item/gc_buyer@odata.bind": "@{concat('accounts(', body('Requirement')?['_gc_buyer_value'], ')')}",
                  "item/gc_seller@odata.bind": "@{concat('accounts(', body('Listing')?['_gc_seller_value'], ')')}",
                  "item/gc_listing@odata.bind": "@{concat('gc_listings(', triggerOutputs()?['body/_gc_listing_value'], ')')}",
                  "item/gc_Requirement@odata.bind": "@{concat('gc_buyerrequirements(', triggerOutputs()?['body/_gc_requirement_value'], ')')}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Listing": [
                  "Succeeded"
                ]
              }
            },
            "Set_commodity": {
              "type": "If",
              "expression": "@not(empty(body('Listing')?['_gc_commodity_value']))",
              "actions": {
                "Link_commodity": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_deals",
                      "recordId": "@{outputs('Create_deal')?['body/gc_dealid']}",
                      "item/gc_commodity@odata.bind": "@{concat('gc_commodities(', body('Listing')?['_gc_commodity_value'], ')')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Create_deal": [
                  "Succeeded"
                ]
              }
            },
            "Set_origin": {
              "type": "If",
              "expression": "@not(empty(body('Listing')?['_gc_origincountry_value']))",
              "actions": {
                "Link_origin": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_deals",
                      "recordId": "@{outputs('Create_deal')?['body/gc_dealid']}",
                      "item/gc_origincountry@odata.bind": "@{concat('gc_countries(', body('Listing')?['_gc_origincountry_value'], ')')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Set_commodity": [
                  "Succeeded"
                ]
              }
            },
            "Set_destination": {
              "type": "If",
              "expression": "@not(empty(body('Requirement')?['_gc_destinationcountry_value']))",
              "actions": {
                "Link_destination": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_deals",
                      "recordId": "@{outputs('Create_deal')?['body/gc_dealid']}",
                      "item/gc_destinationcountry@odata.bind": "@{concat('gc_countries(', body('Requirement')?['_gc_destinationcountry_value'], ')')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Set_origin": [
                  "Succeeded"
                ]
              }
            },
            "Notify_buyer": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{body('Requirement')?['_gc_buyer_value']}",
                  "text_1": "You are connected with a verified seller",
                  "text_2": "Both sides opted in on '@{body('Listing')?['gc_name']}'. Use DealOS to request and compare offers with landed cost. Identities stay masked until a contract is signed.",
                  "text_3": "match.mutual"
                }
              },
              "runAfter": {
                "Set_destination": [
                  "Succeeded"
                ]
              }
            },
            "Notify_seller": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{body('Listing')?['_gc_seller_value']}",
                  "text_1": "You are connected with a verified buyer",
                  "text_2": "Both sides opted in on your listing '@{body('Listing')?['gc_name']}'. Use DealOS to send your offer. Identities stay masked until a contract is signed.",
                  "text_3": "match.mutual"
                }
              },
              "runAfter": {
                "Notify_buyer": [
                  "Succeeded"
                ]
              }
            },
            "Audit": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_auditevents",
                  "item/gc_hash": "set-by-invariants-plugin",
                  "item/gc_name": "match.mutual",
                  "item/gc_actor": "flow:match-accepted",
                  "item/gc_action": "match.mutual",
                  "item/gc_subjecttype": "gc_match",
                  "item/gc_subjectid": "@{triggerOutputs()?['body/gc_matchid']}",
                  "item/gc_details": "@{take(string(addProperty(json('{}'), 'deal', outputs('Create_deal')?['body/gc_dealid'])), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Notify_seller": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | Match accepted",
                  "item/gc_flowname": "DealOS | Match accepted",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}