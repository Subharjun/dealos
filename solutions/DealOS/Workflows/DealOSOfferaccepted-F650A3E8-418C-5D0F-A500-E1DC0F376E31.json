{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_an_offer_is_accepted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "gc_offer",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "gc_status eq 303300002",
              "subscriptionRequest/filteringattributes": "gc_status"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Accept": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "actionName": "gc_AcceptOffer",
                  "item/OfferId": "@{triggerOutputs()?['body/gc_offerid']}"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {}
            },
            "Audit": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_auditevents",
                  "item/gc_hash": "set-by-invariants-plugin",
                  "item/gc_name": "offer.accept.flow",
                  "item/gc_actor": "flow:offer-accepted",
                  "item/gc_action": "offer.accept.flow",
                  "item/gc_subjecttype": "gc_offer",
                  "item/gc_subjectid": "@{triggerOutputs()?['body/gc_offerid']}",
                  "item/gc_details": "@{take(string(addProperty(addProperty(json('{}'), 'status', outputs('Accept')?['body/Status']), 'summary', outputs('Accept')?['body/Summary'])), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Accept": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | Offer accepted",
                  "item/gc_flowname": "DealOS | Offer accepted",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Reopen_offer": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_offers",
                  "recordId": "@{triggerOutputs()?['body/gc_offerid']}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            },
            "Ask_deal_manager": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_reviewtasks",
                  "item/gc_name": "@{take(concat('Offer acceptance refused: ', coalesce(triggerOutputs()?['body/gc_name'], '')), 100)}",
                  "item/gc_kind": 303300001,
                  "item/gc_purpose": 303300009,
                  "item/gc_assigneerole": 303300002,
                  "item/gc_status": 303300000,
                  "item/gc_payload": "@{string(addProperty(json('{}'), 'error', take(string(result('Try')), 3000)))}",
                  "item/gc_deal@odata.bind": "gc_deals(@{triggerOutputs()?['body/_gc_deal_value']})"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Reopen_offer": [
                  "Succeeded"
                ]
              }
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Ask_deal_manager": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}