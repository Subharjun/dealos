{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_release_is_settled": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "gc_paymentrelease",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "gc_status eq 303300004",
              "subscriptionRequest/filteringattributes": "gc_status"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Payment": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_payments",
                  "recordId": "@{triggerOutputs()?['body/_gc_payment_value']}",
                  "$select": "gc_name,gc_currency,_gc_deal_value"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Deal": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_deals",
                  "recordId": "@{body('Payment')?['_gc_deal_value']}",
                  "$select": "gc_name,_gc_seller_value"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Payment": [
                  "Succeeded"
                ]
              }
            },
            "Notify_seller": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{body('Deal')?['_gc_seller_value']}",
                  "text_1": "Payment released",
                  "text_2": "A payment for '@{body('Deal')?['gc_name']}' is settled: @{body('Payment')?['gc_currency']} @{formatNumber(triggerOutputs()?['body/gc_netamount'], 'N2')} to you after commission of @{formatNumber(triggerOutputs()?['body/gc_commissionamount'], 'N2')}, from a gross release of @{formatNumber(triggerOutputs()?['body/gc_amount'], 'N2')}.",
                  "text_3": "release.settled"
                }
              },
              "runAfter": {
                "Deal": [
                  "Succeeded"
                ]
              }
            },
            "Unsettled": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_paymentreleases",
                  "$select": "gc_paymentreleaseid",
                  "$filter": "_gc_payment_value eq @{triggerOutputs()?['body/_gc_payment_value']} and gc_status ne 303300004 and gc_status ne 303300005"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Notify_seller": [
                  "Succeeded"
                ]
              }
            },
            "All_settled": {
              "type": "If",
              "expression": "@equals(length(outputs('Unsettled')?['body/value']), 0)",
              "actions": {
                "Payment_settled": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_payments",
                      "recordId": "@{triggerOutputs()?['body/_gc_payment_value']}",
                      "item/gc_state": 303300004
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "To_settled": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "PerformUnboundAction",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "actionName": "gc_TransitionDeal",
                      "item/DealId": "@{body('Payment')?['_gc_deal_value']}",
                      "item/TargetStage": 303300010,
                      "item/Reason": "All releases settled"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Payment_settled": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Unsettled": [
                  "Succeeded"
                ]
              }
            },
            "Audit": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_auditevents",
                  "item/gc_hash": "set-by-invariants-plugin",
                  "item/gc_name": "release.settled",
                  "item/gc_actor": "flow:release-settled",
                  "item/gc_action": "release.settled",
                  "item/gc_subjecttype": "gc_paymentrelease",
                  "item/gc_subjectid": "@{triggerOutputs()?['body/gc_paymentreleaseid']}",
                  "item/gc_details": "@{take(string(addProperty(addProperty(json('{}'), 'net', triggerOutputs()?['body/gc_netamount']), 'commission', triggerOutputs()?['body/gc_commissionamount'])), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "All_settled": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | Release settled",
                  "item/gc_flowname": "DealOS | Release settled",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}