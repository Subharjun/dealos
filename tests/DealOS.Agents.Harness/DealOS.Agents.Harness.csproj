<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checks for the agent plug-in: JSON, validator, schemas; also writes the agent manifest used by tools/deploy_agents.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>NU1701</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" />
    <Reference Include="DealOS.Agents">
      <HintPath>../../src/DealOS.Agents/bin/Release/net462/DealOS.Agents.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
