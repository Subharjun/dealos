{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_dispute_closes": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "gc_dispute",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "gc_status"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@or(equals(triggerOutputs()?['body/gc_status'], 303300003), equals(triggerOutputs()?['body/gc_status'], 303300004))"
            }
          ],
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Deal": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_deals",
                  "recordId": "@{triggerOutputs()?['body/_gc_deal_value']}",
                  "$select": "gc_name,gc_statusoverlay,_gc_buyer_value,_gc_seller_value"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Stamp_resolved": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_disputes",
                  "recordId": "@{triggerOutputs()?['body/gc_disputeid']}",
                  "item/gc_resolvedon": "@utcNow()"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Deal": [
                  "Succeeded"
                ]
              }
            },
            "Close_task": {
              "type": "If",
              "expression": "@not(empty(triggerOutputs()?['body/_gc_reviewtask_value']))",
              "actions": {
                "Task_state": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "GetItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_reviewtasks",
                      "recordId": "@{triggerOutputs()?['body/_gc_reviewtask_value']}",
                      "$select": "gc_status"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Still_open": {
                  "type": "If",
                  "expression": "@equals(body('Task_state')?['gc_status'], 303300000)",
                  "actions": {
                    "Cancel_task": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "gc_reviewtasks",
                          "recordId": "@{triggerOutputs()?['body/_gc_reviewtask_value']}",
                          "item/gc_status": 303300003
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Task_state": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Stamp_resolved": [
                  "Succeeded"
                ]
              }
            },
            "Other_open": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_disputes",
                  "$select": "gc_disputeid",
                  "$filter": "_gc_deal_value eq @{triggerOutputs()?['body/_gc_deal_value']} and gc_disputeid ne @{triggerOutputs()?['body/gc_disputeid']} and (gc_status eq 303300000 or gc_status eq 303300001 or gc_status eq 303300002 or gc_status eq 303300005)",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Close_task": [
                  "Succeeded"
                ]
              }
            },
            "Lift_overlay": {
              "type": "If",
              "expression": "@and(equals(length(outputs('Other_open')?['body/value']), 0), equals(body('Deal')?['gc_statusoverlay'], 303300002))",
              "actions": {
                "Clear_overlay": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_deals",
                      "recordId": "@{triggerOutputs()?['body/_gc_deal_value']}",
                      "item/gc_statusoverlay": 303300000
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Other_open": [
                  "Succeeded"
                ]
              }
            },
            "Refund_outcome": {
              "type": "If",
              "expression": "@and(equals(triggerOutputs()?['body/gc_status'], 303300003), or(equals(triggerOutputs()?['body/gc_resolution'], 303300002), equals(triggerOutputs()?['body/gc_resolution'], 303300003)))",
              "actions": {
                "Refund_task": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_reviewtasks",
                      "item/gc_name": "@{take(concat('Refund after dispute: ', body('Deal')?['gc_name']), 100)}",
                      "item/gc_kind": 303300000,
                      "item/gc_purpose": 303300005,
                      "item/gc_assigneerole": 303300004,
                      "item/gc_status": 303300000,
                      "item/gc_payload": "@{string(addProperty(addProperty(addProperty(addProperty(json('{}'), 'disputeId', triggerOutputs()?['body/gc_disputeid']), 'resolution', coalesce(json('{\"303300000\": \"None\", \"303300001\": \"Release To Seller\", \"303300002\": \"Refund To Buyer\", \"303300003\": \"Partial Refund\", \"303300004\": \"Price Adjustment\", \"303300005\": \"Deal Cancelled\"}')?[string(triggerOutputs()?['body/gc_resolution'])], 'None')), 'amount', triggerOutputs()?['body/gc_amountdisputed']), 'outcome', triggerOutputs()?['body/gc_financialoutcome']))}",
                      "item/gc_deal@odata.bind": "gc_deals(@{triggerOutputs()?['body/_gc_deal_value']})"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Lift_overlay": [
                  "Succeeded"
                ]
              }
            },
            "Cancel_outcome": {
              "type": "If",
              "expression": "@and(equals(triggerOutputs()?['body/gc_status'], 303300003), equals(triggerOutputs()?['body/gc_resolution'], 303300005))",
              "actions": {
                "To_cancelled": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "PerformUnboundAction",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "actionName": "gc_TransitionDeal",
                      "item/DealId": "@{triggerOutputs()?['body/_gc_deal_value']}",
                      "item/TargetStage": 303300012,
                      "item/Reason": "Dispute resolved: deal cancelled"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Cancel_refused": {
                  "type": "If",
                  "expression": "@not(equals(outputs('To_cancelled')?['body/Allowed'], true))",
                  "actions": {
                    "Cancel_stuck_task": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "gc_reviewtasks",
                          "item/gc_name": "@{take(concat('Dispute resolved but deal not cancelled: ', body('Deal')?['gc_name']), 100)}",
                          "item/gc_kind": 303300001,
                          "item/gc_purpose": 303300009,
                          "item/gc_assigneerole": 303300002,
                          "item/gc_status": 303300000,
                          "item/gc_payload": "@{string(addProperty(json('{}'), 'failures', outputs('To_cancelled')?['body/Failures']))}",
                          "item/gc_deal@odata.bind": "gc_deals(@{triggerOutputs()?['body/_gc_deal_value']})"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "To_cancelled": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Refund_outcome": [
                  "Succeeded"
                ]
              }
            },
            "Notify_buyer": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{body('Deal')?['_gc_buyer_value']}",
                  "text_1": "Dispute closed",
                  "text_2": "The dispute on '@{body('Deal')?['gc_name']}' is closed. Outcome: @{if(equals(triggerOutputs()?['body/gc_status'], 303300004), 'withdrawn', coalesce(json('{\"303300000\": \"None\", \"303300001\": \"Release To Seller\", \"303300002\": \"Refund To Buyer\", \"303300003\": \"Partial Refund\", \"303300004\": \"Price Adjustment\", \"303300005\": \"Deal Cancelled\"}')?[string(triggerOutputs()?['body/gc_resolution'])], 'None'))}. Any payment step that follows will be confirmed to you in DealOS.",
                  "text_3": "dispute.closed"
                }
              },
              "runAfter": {
                "Cancel_outcome": [
                  "Succeeded"
                ]
              }
            },
            "Notify_seller": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{body('Deal')?['_gc_seller_value']}",
                  "text_1": "Dispute closed",
                  "text_2": "The dispute on '@{body('Deal')?['gc_name']}' is closed. Outcome: @{if(equals(triggerOutputs()?['body/gc_status'], 303300004), 'withdrawn', coalesce(json('{\"303300000\": \"None\", \"303300001\": \"Release To Seller\", \"303300002\": \"Refund To Buyer\", \"303300003\": \"Partial Refund\", \"303300004\": \"Price Adjustment\", \"303300005\": \"Deal Cancelled\"}')?[string(triggerOutputs()?['body/gc_resolution'])], 'None'))}. Any payment step that follows will be confirmed to you in DealOS.",
                  "text_3": "dispute.closed"
                }
              },
              "runAfter": {
                "Notify_buyer": [
                  "Succeeded"
                ]
              }
            },
            "Audit": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_auditevents",
                  "item/gc_hash": "set-by-invariants-plugin",
                  "item/gc_name": "dispute.closed",
                  "item/gc_actor": "flow:dispute",
                  "item/gc_action": "dispute.closed",
                  "item/gc_subjecttype": "gc_dispute",
                  "item/gc_subjectid": "@{triggerOutputs()?['body/gc_disputeid']}",
                  "item/gc_details": "@{take(string(addProperty(addProperty(json('{}'), 'status', triggerOutputs()?['body/gc_status']), 'resolution', coalesce(json('{\"303300000\": \"None\", \"303300001\": \"Release To Seller\", \"303300002\": \"Refund To Buyer\", \"303300003\": \"Partial Refund\", \"303300004\": \"Price Adjustment\", \"303300005\": \"Deal Cancelled\"}')?[string(triggerOutputs()?['body/gc_resolution'])], 'None'))), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Notify_seller": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | Dispute closed",
                  "item/gc_flowname": "DealOS | Dispute closed",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}