{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_sourcing_starts": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "gc_buyerrequirement",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "gc_deskstage eq 303300001",
              "subscriptionRequest/filteringattributes": "gc_deskstage"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@and(equals(triggerOutputs()?['body/gc_source'], 303300001), empty(triggerOutputs()?['body/gc_discoveredon']))"
            }
          ],
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Discover": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "actionName": "gc_DiscoverSellers",
                  "item/RequirementId": "@{triggerOutputs()?['body/gc_buyerrequirementid']}"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {}
            },
            "Found_some": {
              "type": "If",
              "expression": "@greater(int(coalesce(outputs('Discover')?['body/Found'], 0)), 0)",
              "actions": {
                "Source_again": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "PerformUnboundAction",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "actionName": "gc_SourceRequirement",
                      "item/RequirementId": "@{triggerOutputs()?['body/gc_buyerrequirementid']}"
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Discover": [
                  "Succeeded"
                ]
              }
            },
            "Brief_owner": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "actionName": "gc_DeskBrief",
                  "item/Subject": "@{concat('Seller search: ', coalesce(triggerOutputs()?['body/gc_commoditytext'], triggerOutputs()?['body/gc_name']))}",
                  "item/Text": "@{concat('Web search: ', coalesce(json(coalesce(outputs('Discover')?['body/Result'], '{}'))?['status'], ''), '. ', coalesce(json(coalesce(outputs('Discover')?['body/Result'], '{}'))?['reason'], ''), decodeUriComponent('%0A'), 'Companies found: ', string(coalesce(json(coalesce(outputs('Discover')?['body/Result'], '{}'))?['found'], 0)), ', with a published email: ', string(coalesce(json(coalesce(outputs('Discover')?['body/Result'], '{}'))?['with_email'], 0)), decodeUriComponent('%0A'), 'New enquiries opened: ', string(coalesce(outputs('Source_again')?['body/Invited'], 0)), decodeUriComponent('%0A%0A'), 'Leads without an email are listed in the task Find contacts for sourcing. Enquiry drafts are in Gmail > Drafts.')}"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {
                "Found_some": [
                  "Succeeded",
                  "Failed",
                  "Skipped"
                ]
              }
            },
            "Audit": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_auditevents",
                  "item/gc_hash": "set-by-invariants-plugin",
                  "item/gc_name": "requirement.discovered",
                  "item/gc_actor": "flow:seller-discovery",
                  "item/gc_action": "requirement.discovered",
                  "item/gc_subjecttype": "gc_buyerrequirement",
                  "item/gc_subjectid": "@{triggerOutputs()?['body/gc_buyerrequirementid']}",
                  "item/gc_details": "@{take(string(addProperty(json('{}'), 'result', outputs('Discover')?['body/Result'])), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Brief_owner": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | Seller discovery",
                  "item/gc_flowname": "DealOS | Seller discovery",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}