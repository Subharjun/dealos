{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_an_RFQ_opens": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "gc_buyerrequirement",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "gc_status eq 303300001",
              "subscriptionRequest/filteringattributes": "gc_status"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@not(equals(triggerOutputs()?['body/gc_source'], 303300001))"
            }
          ],
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Run_Matching": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "actionName": "gc_Agent_Matching",
                  "item/Input": "{\"trigger\": \"flow:rfq-matching\"}",
                  "item/SubjectId": "@{triggerOutputs()?['body/gc_buyerrequirementid']}"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {}
            },
            "Check_Matching": {
              "type": "If",
              "expression": "@not(equals(outputs('Run_Matching')?['body/Status'], 'Succeeded'))",
              "actions": {
                "Record_Matching_failure": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_flowfailures",
                      "item/gc_name": "DealOS | RFQ matching",
                      "item/gc_flowname": "DealOS | RFQ matching",
                      "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                      "item/gc_step": "Run_Matching",
                      "item/gc_error": "@{coalesce(outputs('Run_Matching')?['body/Summary'], 'agent call failed')}",
                      "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                      "item/gc_status": 303300000
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Stop_Matching_failed": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "DealOSFlowFailure",
                      "message": "Matching agent failed; see Flow failures"
                    }
                  },
                  "runAfter": {
                    "Record_Matching_failure": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Run_Matching": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Parse_Matching": {
              "type": "ParseJson",
              "inputs": {
                "content": "@json(coalesce(outputs('Run_Matching')?['body/Result'], '{}'))",
                "schema": {
                  "type": "object",
                  "properties": {
                    "agent": {
                      "type": "string"
                    },
                    "run_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "error": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "result": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "proposed": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "candidate_id": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "reason": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            }
                          }
                        },
                        "skipped": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "candidate_id": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "reason": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            }
                          }
                        },
                        "summary": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "needs_human": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "confidence": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "actions": {
                      "type": [
                        "array",
                        "null"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Check_Matching": [
                  "Succeeded"
                ]
              }
            },
            "Audit": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_auditevents",
                  "item/gc_hash": "set-by-invariants-plugin",
                  "item/gc_name": "rfq.matched",
                  "item/gc_actor": "flow:rfq-matching",
                  "item/gc_action": "rfq.matched",
                  "item/gc_subjecttype": "gc_buyerrequirement",
                  "item/gc_subjectid": "@{triggerOutputs()?['body/gc_buyerrequirementid']}",
                  "item/gc_details": "@{take(string(addProperty(addProperty(json('{}'), 'proposed', length(coalesce(body('Parse_Matching')?['result']?['proposed'], json('[]')))), 'summary', outputs('Run_Matching')?['body/Summary'])), 100000)}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Parse_Matching": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | RFQ matching",
                  "item/gc_flowname": "DealOS | RFQ matching",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}