{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gc_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_terms_are_agreed": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "gc_deal",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "gc_stage eq 303300002",
              "subscriptionRequest/filteringattributes": "gc_stage"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Notify_buyer": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{triggerOutputs()?['body/_gc_buyer_value']}",
                  "text_1": "Terms agreed",
                  "text_2": "Terms are agreed on '@{triggerOutputs()?['body/gc_name']}'. Compliance checks run next; you will hear from us before the contract is issued.",
                  "text_3": "deal.terms_agreed"
                }
              },
              "runAfter": {}
            },
            "Notify_seller": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "4f7bfa4c-432c-512b-b763-c703a64a583b"
                },
                "body": {
                  "text": "@{triggerOutputs()?['body/_gc_seller_value']}",
                  "text_1": "Terms agreed",
                  "text_2": "Terms are agreed on '@{triggerOutputs()?['body/gc_name']}'. Compliance checks run next; you will hear from us before the contract is issued.",
                  "text_3": "deal.terms_agreed"
                }
              },
              "runAfter": {
                "Notify_buyer": [
                  "Succeeded"
                ]
              }
            },
            "To_compliance": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "actionName": "gc_TransitionDeal",
                  "item/DealId": "@{triggerOutputs()?['body/gc_dealid']}",
                  "item/TargetStage": 303300003,
                  "item/Reason": "Terms agreed"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Notify_seller": [
                  "Succeeded"
                ]
              }
            },
            "Compliance_refused": {
              "type": "If",
              "expression": "@not(equals(outputs('To_compliance')?['body/Allowed'], true))",
              "actions": {
                "Stuck_task": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "gc_reviewtasks",
                      "item/gc_name": "@{take(concat('Deal stuck at Terms Agreed: ', triggerOutputs()?['body/gc_name']), 100)}",
                      "item/gc_kind": 303300001,
                      "item/gc_purpose": 303300009,
                      "item/gc_assigneerole": 303300002,
                      "item/gc_status": 303300000,
                      "item/gc_payload": "@{string(addProperty(json('{}'), 'failures', outputs('To_compliance')?['body/Failures']))}",
                      "item/gc_deal@odata.bind": "gc_deals(@{triggerOutputs()?['body/gc_dealid']})"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "To_compliance": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Record_failure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "gc_flowfailures",
                  "item/gc_name": "DealOS | Terms agreed",
                  "item/gc_flowname": "DealOS | Terms agreed",
                  "item/gc_runurl": "https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}",
                  "item/gc_step": "Try",
                  "item/gc_error": "@{take(string(result('Try')), 3900)}",
                  "item/gc_payload": "@{take(string(triggerOutputs()?['body']), 100000)}",
                  "item/gc_status": 303300000
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Fail_run": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "DealOSFlowFailure",
                  "message": "Recorded in Flow failures"
                }
              },
              "runAfter": {
                "Record_failure": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}